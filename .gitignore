# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Terraform variable files (often contain secrets)
*.tfvars
*.tfvars.json

# Terraform plan output
*.tfplan
plan.out

# Crash logs
crash.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config / local metadata
.terraformrc
terraform.rc